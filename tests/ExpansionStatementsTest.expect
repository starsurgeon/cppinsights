void iterable()
{
  constexpr const int arr[3] = {1, 2, 3};
  template for(constexpr auto x : {arr[0], arr[1], arr[2]})
  {
    int y = x;
  }
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    {
      int y = x;
    };
  }
  #endif
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    {
      int y = x;
    };
  }
  #endif
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    {
      int y = x;
    };
  }
  #endif
}

void init_list()
{
  template for(constexpr auto x : {4, 5})
  {
    int y = x;
  }
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    constexpr const int x = 4;
    {
      int y = x;
    };
  }
  #endif
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    constexpr const int x = 5;
    {
      int y = x;
    };
  }
  #endif
}

struct Pair
{
  int a;
  int b;
  // inline constexpr Pair(const Pair &) noexcept = default;
};

void destructurable()
{
  constexpr const Pair p = {10, 20};
  template for(constexpr auto x : Pair(p))
  {
    int y = x;
  }
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    {
      int y = x;
    };
  }
  #endif
  #ifdef INSIGHTS_USE_TEMPLATE
  {
    {
      int y = x;
    };
  }
  #endif
}

struct WithValues
{
  inline static constexpr const int values[2] = {7, 8};
};


template<typename T>
void indeterminate()
{
  template for(constexpr auto x : T::values)
  {
    int y = x;
  }
}

/* First instantiated from: ExpansionStatementsTest.cpp:42 */
#ifdef INSIGHTS_USE_TEMPLATE
template<>
void indeterminate<WithValues>()
{
  
  {
    constexpr const auto __range = {WithValues::values[0], WithValues::values[1]};
  {
    {
      int y = x;
    };
  }
  {
    {
      int y = x;
    };
  }
  }
}
#endif


int main()
{
  iterable();
  init_list();
  destructurable();
  indeterminate<WithValues>();
  return 0;
}
